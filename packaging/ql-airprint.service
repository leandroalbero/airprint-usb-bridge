[Unit]
Description=Brother QL label printer as an AirPrint / IPP Everywhere printer
Documentation=https://github.com/leandroalbero/airprint-usb-bridge
After=network-online.target avahi-daemon.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/ql-airprint --config /etc/ql-airprint/ql-airprint.conf serve
Restart=on-failure
RestartSec=5s
# A stop lets the label being printed finish; with the printer cooling down that
# can take up to the 15 min the service itself allows.
TimeoutStopSec=16min
# Caps a hostile or broken job; the service keeps a 64 MiB document and up to
# 128 MiB of decoded raster per job. GOMEMLIMIT makes the Go GC work harder
# before the hard limit is reached.
MemoryMax=512M
Environment=GOMEMLIMIT=384MiB

DynamicUser=yes
# /dev/usb/lp* is group lp on most distributions.
SupplementaryGroups=lp
StateDirectory=ql-airprint
StateDirectoryMode=0700
ConfigurationDirectory=ql-airprint
UMask=0077

# The default port 8631 needs no privileges. To listen on 631 instead, uncomment:
#AmbientCapabilities=CAP_NET_BIND_SERVICE
#CapabilityBoundingSet=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=
NoNewPrivileges=yes

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# PrivateDevices= would hide /dev/usb/lp*; allow only the USB character major (180, "usb").
DevicePolicy=closed
DeviceAllow=char-usb rw
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
# AF_UNIX: D-Bus to avahi-daemon. AF_INET/AF_INET6: IPP and the built-in mDNS responder.
# AF_NETLINK: the built-in responder watches interface changes.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
# Return EPERM instead of killing the process: the Go runtime raises RLIMIT_NOFILE at start-up.
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
